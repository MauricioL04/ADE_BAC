{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python scripts/ade/guard.py",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python scripts/ade/log_interaction.py",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python scripts/ade/log_interaction.py",
        "timeout": 10
      }
    ]
  }
}
